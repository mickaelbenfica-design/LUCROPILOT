<!doctype html>
<html lang="pt">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>LucroPilot — Gestão inteligente</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;color:#eaf1ff;background:#0b1120;font-synthesis:none}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}.app{display:grid;grid-template-columns:230px 1fr;min-height:100vh}.side{background:#0f192d;padding:30px 18px;border-right:1px solid #24344a}.brand{font-size:23px;font-weight:850;letter-spacing:-.8px;margin-bottom:6px}.brand span{color:#52dbb1}.sub{color:#92a4bc;font-size:12px}.nav{display:flex;flex-direction:column;gap:6px;margin-top:38px}.nav button{border:0;background:transparent;color:#afc0d4;text-align:left;border-radius:12px;padding:13px;font-weight:600}.nav button.active,.nav button:hover{background:#20334b;color:#fff}.sidefoot{font-size:12px;color:#92a4bc;margin-top:60px;line-height:1.6}.main{padding:35px;max-width:1450px;width:100%;margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:28px}h1{font-size:29px;letter-spacing:-.7px;margin:0 0 5px}h2{font-size:19px;margin:0 0 18px}.muted{color:#98abc3;font-size:13px}.btn{background:#41d7ab;border:0;border-radius:10px;color:#062118;font-weight:750;padding:12px 16px}.btn:hover{background:#78ebc8}.btn.secondary{background:#202f45;color:#e8efff}.btn.danger{background:#542b39;color:#ffdce4}.actions{display:flex;gap:8px;flex-wrap:wrap}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:22px}.card,.panel{background:#151f32;border:1px solid #25344b;border-radius:17px;padding:21px}.metric{font-size:27px;font-weight:800;letter-spacing:-.9px;margin:14px 0 4px;overflow-wrap:anywhere}.green{color:#4ce1b5}.red{color:#ff8c9e}.blue{color:#9cbaff}.tiny{font-size:12px;color:#9cafc7}.content{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.barrow{display:grid;grid-template-columns:85px 1fr 100px;align-items:center;gap:8px;margin:13px 0;font-size:12px}.track{height:12px;background:#293a50;border-radius:12px;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#2ebc9b,#65e5c0);border-radius:12px}.tablescroll{overflow:auto}table{border-collapse:collapse;width:100%;min-width:690px}th{text-align:left;color:#91a7c0;font-size:12px;font-weight:600;padding:13px 9px;border-bottom:1px solid #2a3b53}td{font-size:13px;padding:14px 9px;border-bottom:1px solid #23334a}tr:last-child td{border-bottom:0}.tag{display:inline-block;border-radius:30px;padding:5px 9px;background:#23364e;font-size:11px}.tag.sale{background:#174939;color:#7ef1c3}.tag.buy{background:#503038;color:#ffb4bc}.section{display:none}.section.visible{display:block}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;align-items:end}.field{display:flex;flex-direction:column;gap:7px;flex:1;min-width:155px}.field label{font-size:12px;color:#a8bad0}.field input,.field select{background:#101a2a;border:1px solid #34455e;border-radius:9px;padding:11px;color:#fff;min-height:43px;width:100%}.field input:focus,.field select:focus{outline:2px solid #45dcb0;outline-offset:1px}.empty{padding:20px;color:#9aacc2;text-align:center}.help{background:#1e3045;border-left:3px solid #4be0b6;border-radius:7px;padding:13px 16px;margin:20px 0;color:#d5e3f4;font-size:13px;line-height:1.6}.modal{position:fixed;inset:0;background:#030711bb;display:flex;align-items:center;justify-content:center;padding:18px;z-index:5}.modal[hidden]{display:none}.modalbody{background:#19253a;border:1px solid #40516a;border-radius:18px;padding:25px;max-width:600px;width:100%;max-height:90vh;overflow:auto}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.full{grid-column:1/-1}.right{text-align:right}.small-btn{font-size:12px;padding:7px 9px;border-radius:8px;border:1px solid #38506b;background:#22364d;color:#e8efff}.summary{line-height:1.85}.pill{background:#21344c;padding:5px 10px;border-radius:30px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:950px){.app{grid-template-columns:1fr}.side{padding:15px}.nav{flex-direction:row;overflow-x:auto;margin-top:15px}.nav button{white-space:nowrap}.sidefoot{display:none}.main{padding:20px}.cards{grid-template-columns:repeat(2,1fr)}.content{grid-template-columns:1fr}}@media(max-width:520px){.cards{grid-template-columns:1fr 1fr;gap:8px}.card,.panel{padding:14px}.metric{font-size:20px}.formgrid{grid-template-columns:1fr}.main{padding:14px}}
</style>
</head>
<body>
<div class="app"><aside class="side"><div class="brand">Lucro<span>Pilot</span></div><div class="sub">O teu negócio, sob controlo.</div><nav class="nav"><button data-tab="dashboard" class="active">◫ &nbsp; Painel geral</button><button data-tab="documents">▤ &nbsp; Faturas</button><button data-tab="companies">▦ &nbsp; Empresas</button><button data-tab="settings">⚙ &nbsp; Dados e segurança</button></nav><div class="sidefoot">Versão gratuita local<br>Os dados ficam neste navegador.</div></aside>
<main class="main">
<div class="top"><div><h1 id="pageTitle">Painel de gestão</h1><div class="muted" id="pageSubtitle">Visão geral da rentabilidade</div></div><div class="actions"><button class="btn secondary" id="exportTop">↓ Exportar dados</button><button class="btn" id="newInvoiceTop">+ Nova fatura</button></div></div>
<section id="dashboard" class="section visible"><div class="toolbar"><div class="field"><label for="dashCompany">Empresa</label><select id="dashCompany"></select></div><div class="field"><label for="dashMonth">Mês</label><input type="month" id="dashMonth"></div><button class="btn secondary" id="dashAllMonths">Todo o período</button></div><div class="cards"><div class="card"><div class="muted">Vendas sem IVA</div><div class="metric green" id="salesTotal">0 €</div><div class="tiny">Faturas de venda</div></div><div class="card"><div class="muted">Compras / despesas sem IVA</div><div class="metric" id="buyTotal">0 €</div><div class="tiny">Faturas de compra</div></div><div class="card"><div class="muted">Resultado estimado</div><div class="metric blue" id="resultTotal">0 €</div><div class="tiny">Vendas − compras</div></div><div class="card"><div class="muted">Margem sobre vendas</div><div class="metric" id="marginTotal">—</div><div class="tiny">Resultado ÷ vendas</div></div></div><div class="content"><div class="panel"><h2>Despesas por categoria</h2><div id="categories"></div></div><div class="panel"><h2>Resumo do período</h2><div id="periodSummary" class="summary muted"></div></div></div><div class="panel" style="margin-top:16px"><h2>Últimas faturas</h2><div class="tablescroll"><table><thead><tr><th>Data</th><th>Tipo</th><th>Cliente / fornecedor</th><th>Empresa</th><th>Total sem IVA</th></tr></thead><tbody id="recentRows"></tbody></table></div></div><div class="help"><strong>Nota:</strong> resultado de gestão simplificado, calculado pelos documentos introduzidos. Não inclui automaticamente salários, amortizações, impostos, stocks ou outros custos sem fatura. Não substitui a contabilidade oficial.</div></section>
<section id="documents" class="section"><div class="toolbar"><div class="field"><label for="invoiceCompany">Empresa</label><select id="invoiceCompany"></select></div><div class="field"><label for="invoiceType">Tipo</label><select id="invoiceType"><option value="all">Todas</option><option value="sale">Vendas</option><option value="buy">Compras</option></select></div><div class="field"><label for="invoiceSearch">Pesquisar</label><input id="invoiceSearch" placeholder="Número, entidade, categoria…"></div></div><div class="panel"><h2>Registo de faturas</h2><div class="tablescroll"><table><thead><tr><th>Data</th><th>Fatura</th><th>Tipo</th><th>Entidade</th><th>Categoria</th><th>Sem IVA</th><th>IVA</th><th>Ações</th></tr></thead><tbody id="invoiceRows"></tbody></table></div></div><div class="help">Nesta primeira versão, introduzes os valores manualmente. A leitura automática de PDF, a emissão de faturas fiscais e a sincronização online ainda não estão incluídas.</div></section>
<section id="companies" class="section"><div class="panel"><h2>Empresas</h2><p class="muted">Podes registar várias empresas e consultar a rentabilidade individual ou consolidada.</p><form id="companyForm" class="toolbar"><div class="field"><label for="companyName">Nome da nova empresa</label><input id="companyName" maxlength="90" placeholder="Ex.: Transportes Silva" required></div><button class="btn" type="submit">+ Adicionar empresa</button></form><div id="companyList"></div></div></section>
<section id="settings" class="section"><div class="panel"><h2>Cópias de segurança</h2><p class="muted">Os registos estão apenas neste dispositivo e neste navegador. Exporta regularmente uma cópia JSON, sobretudo antes de limpar os dados do navegador.</p><div class="actions"><button class="btn" id="exportJson">Descarregar cópia JSON</button><button class="btn secondary" id="exportCsv">Exportar faturas CSV</button><label class="btn secondary" for="importJson">Importar cópia JSON</label><input class="sr-only" type="file" id="importJson" accept=".json,application/json"></div><div class="help">Importar uma cópia substitui os dados atuais, após confirmação. Não uses dados confidenciais num computador partilhado. Esta aplicação não tem autenticação, servidor nem cópias automáticas.</div><button class="btn danger" id="resetData">Apagar todos os dados locais</button></div></section>
</main></div>
<div class="modal" id="invoiceModal" hidden><div class="modalbody"><div class="top"><div><h2 id="modalTitle">Nova fatura</h2><div class="muted">Preenche os dados da fatura</div></div><button class="small-btn" id="closeModal" type="button">Fechar ✕</button></div><form id="invoiceForm" class="formgrid"><input type="hidden" id="editId"><div class="field"><label for="formCompany">Empresa *</label><select id="formCompany" required></select></div><div class="field"><label for="formType">Tipo *</label><select id="formType" required><option value="sale">Venda</option><option value="buy">Compra / despesa</option></select></div><div class="field"><label for="formDate">Data *</label><input type="date" id="formDate" required></div><div class="field"><label for="formNumber">N.º da fatura *</label><input id="formNumber" maxlength="80" required placeholder="FT 2026/001"></div><div class="field full"><label for="formPartner">Cliente / fornecedor *</label><input id="formPartner" maxlength="150" required placeholder="Nome da entidade"></div><div class="field"><label for="formCategory">Categoria *</label><select id="formCategory" required></select></div><div class="field"><label for="formAmount">Valor sem IVA (€) *</label><input id="formAmount" type="number" min="0" max="999999999" step="0.01" required placeholder="1000.00"></div><div class="field"><label for="formVat">IVA (€) *</label><input id="formVat" type="number" min="0" max="999999999" step="0.01" required value="0"></div><div class="field"><label for="formStatus">Pagamento</label><select id="formStatus"><option value="pending">Pendente</option><option value="paid">Pago / recebido</option></select></div><div class="full right"><button class="btn secondary" type="button" id="cancelInvoice">Cancelar</button> <button class="btn" type="submit">Guardar fatura</button></div></form></div></div>
<script>
'use strict';
const KEY='lucropilot_v1';
const categories=['Combustível','Portagens','Manutenção','Seguros','Equipamentos','Subcontratação','Rendas','Serviços','Material','Marketing','Outros'];
let state=load();let active='dashboard';
const $=id=>document.getElementById(id);
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function money(n){return new Intl.NumberFormat('pt-PT',{style:'currency',currency:'EUR'}).format(n||0)}
function num(v){return Number.isFinite(Number(v))?Number(v):0}
function uid(){return (typeof crypto!=='undefined'&&crypto.randomUUID)?crypto.randomUUID():`${Date.now()}-${Math.random().toString(36).slice(2)}`}
function cleanInitial(){return {companies:[{id:'principal',name:'A minha empresa'}],invoices:[]}}
function validData(x){return x&&Array.isArray(x.companies)&&Array.isArray(x.invoices)&&x.companies.length>0&&x.companies.length<500&&x.invoices.length<50000&&x.companies.every(c=>typeof c.id==='string'&&typeof c.name==='string')&&x.invoices.every(i=>typeof i.id==='string'&&typeof i.companyId==='string'&&['sale','buy'].includes(i.type)&&typeof i.date==='string'&&typeof i.number==='string'&&typeof i.partner==='string'&&typeof i.category==='string'&&Number.isFinite(i.amount)&&i.amount>=0&&Number.isFinite(i.vat)&&i.vat>=0)}
function load(){try{let x=JSON.parse(localStorage.getItem(KEY));return validData(x)?x:cleanInitial()}catch{return cleanInitial()}}
function persist(){try{localStorage.setItem(KEY,JSON.stringify(state));return true}catch{alert('O navegador não conseguiu guardar os dados. Exporta uma cópia e verifica o espaço disponível.');return false}}
function options(sel,withAll=false){const previous=sel.value;sel.innerHTML=(withAll?'<option value="all">Todas as empresas</option>':'')+state.companies.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');if([...sel.options].some(o=>o.value===previous))sel.value=previous}
function companyName(id){return state.companies.find(c=>c.id===id)?.name||'Empresa desconhecida'}
function filtered(company='all',month=''){return state.invoices.filter(x=>(company==='all'||x.companyId===company)&&(!month||x.date.startsWith(month)))}
function paintDashboard(){const items=filtered($('dashCompany').value,$('dashMonth').value);const sales=items.filter(x=>x.type==='sale').reduce((a,x)=>a+x.amount,0),buys=items.filter(x=>x.type==='buy').reduce((a,x)=>a+x.amount,0),profit=sales-buys;$('salesTotal').textContent=money(sales);$('buyTotal').textContent=money(buys);$('resultTotal').textContent=money(profit);$('resultTotal').className='metric '+(profit>=0?'green':'red');$('marginTotal').textContent=sales?(profit/sales*100).toLocaleString('pt-PT',{maximumFractionDigits:1})+' %':'—';const byCat={};items.filter(x=>x.type==='buy').forEach(x=>byCat[x.category]=(byCat[x.category]||0)+x.amount);const entries=Object.entries(byCat).sort((a,b)=>b[1]-a[1]);$('categories').innerHTML=entries.length?entries.map(([name,v])=>`<div class="barrow"><span title="${esc(name)}">${esc(name)}</span><div class="track"><div class="fill" style="width:${buys?Math.max(1,v/buys*100):0}%"></div></div><span class="right">${money(v)}</span></div>`).join(''):'<div class="empty">Ainda não há despesas neste período.</div>';$('periodSummary').innerHTML=`<div>Faturas de venda: <b>${items.filter(x=>x.type==='sale').length}</b></div><div>Faturas de compra: <b>${items.filter(x=>x.type==='buy').length}</b></div><div>Faturas pendentes: <b>${items.filter(x=>x.status!=='paid').length}</b></div><div>Volume total com IVA: <b>${money(items.reduce((a,x)=>a+x.amount+x.vat,0))}</b></div><div>Resultado estimado: <b class="${profit<0?'red':'green'}">${money(profit)}</b></div>`;$('recentRows').innerHTML=items.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6).map(x=>`<tr><td>${esc(x.date)}</td><td><span class="tag ${x.type}">${x.type==='sale'?'Venda':'Compra'}</span></td><td>${esc(x.partner)}</td><td>${esc(companyName(x.companyId))}</td><td>${money(x.amount)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">Ainda não existem faturas. Adiciona a primeira!</td></tr>'}
function paintInvoices(){const q=$('invoiceSearch').value.trim().toLocaleLowerCase('pt-PT'),company=$('invoiceCompany').value,type=$('invoiceType').value;const list=state.invoices.filter(x=>(company==='all'||x.companyId===company)&&(type==='all'||x.type===type)&&[x.number,x.partner,x.category,companyName(x.companyId)].join(' ').toLocaleLowerCase('pt-PT').includes(q)).sort((a,b)=>b.date.localeCompare(a.date));$('invoiceRows').innerHTML=list.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.number)}</td><td><span class="tag ${x.type}">${x.type==='sale'?'Venda':'Compra'}</span></td><td>${esc(x.partner)}<div class="tiny">${esc(companyName(x.companyId))}</div></td><td>${esc(x.category)}</td><td>${money(x.amount)}</td><td>${money(x.vat)}</td><td><button class="small-btn" data-edit="${esc(x.id)}">Editar</button> <button class="small-btn" data-delete="${esc(x.id)}">Apagar</button></td></tr>`).join('')||'<tr><td colspan="8" class="empty">Nenhuma fatura encontrada.</td></tr>'}
function paintCompanies(){$('companyList').innerHTML=state.companies.map(c=>`<div style="display:flex;align-items:center;justify-content:space-between;gap:8px;border-bottom:1px solid #304158;padding:15px 0"><div><b>${esc(c.name)}</b><div class="tiny">${state.invoices.filter(x=>x.companyId===c.id).length} fatura(s)</div></div><button class="small-btn" data-delcompany="${esc(c.id)}">Eliminar</button></div>`).join('')}
function refresh(){['dashCompany','invoiceCompany'].forEach(id=>options($(id),true));options($('formCompany'));paintDashboard();paintInvoices();paintCompanies()}
const titles={dashboard:['Painel de gestão','Visão geral da rentabilidade'],documents:['Faturas','Todas as compras e vendas'],companies:['Empresas','Gestão de várias empresas'],settings:['Dados e segurança','Exportações e cópias de segurança']};
function tab(id){active=id;document.querySelectorAll('.section').forEach(x=>x.classList.toggle('visible',x.id===id));document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x.dataset.tab===id));$('pageTitle').textContent=titles[id][0];$('pageSubtitle').textContent=titles[id][1]}
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>tab(b.dataset.tab)));
function updateCategories(){const sale=$('formType').value==='sale';$('formCategory').innerHTML=(sale?['Vendas','Prestação de serviços','Outras receitas']:categories).map(x=>`<option>${esc(x)}</option>`).join('')}
function showForm(id=''){const i=state.invoices.find(x=>x.id===id);$('invoiceForm').reset();$('editId').value=i?.id||'';options($('formCompany'));$('formType').value=i?.type||'sale';updateCategories();$('formCompany').value=i?.companyId||state.companies[0].id;$('formDate').value=i?.date||new Date().toLocaleDateString('sv-SE');$('formNumber').value=i?.number||'';$('formPartner').value=i?.partner||'';$('formCategory').value=i?.category||$('formCategory').options[0]?.value;$('formAmount').value=i?.amount??'';$('formVat').value=i?.vat??0;$('formStatus').value=i?.status||'pending';$('modalTitle').textContent=i?'Editar fatura':'Nova fatura';$('invoiceModal').hidden=false;$('formNumber').focus()}
function closeForm(){$('invoiceModal').hidden=true}
$('newInvoiceTop').addEventListener('click',()=>showForm());$('closeModal').addEventListener('click',closeForm);$('cancelInvoice').addEventListener('click',closeForm);$('invoiceModal').addEventListener('click',e=>{if(e.target===$('invoiceModal'))closeForm()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeForm()});$('formType').addEventListener('change',updateCategories);
$('invoiceForm').addEventListener('submit',e=>{e.preventDefault();const amt=Number($('formAmount').value),vat=Number($('formVat').value);if(!Number.isFinite(amt)||amt<0||!Number.isFinite(vat)||vat<0){alert('Confirma os valores.');return}const id=$('editId').value;const item={id:id||uid(),companyId:$('formCompany').value,type:$('formType').value,date:$('formDate').value,number:$('formNumber').value.trim(),partner:$('formPartner').value.trim(),category:$('formCategory').value,amount:Math.round(amt*100)/100,vat:Math.round(vat*100)/100,status:$('formStatus').value};if(!state.companies.some(c=>c.id===item.companyId)){alert('Empresa inválida.');return}if(state.invoices.some(i=>i.id!==id&&i.companyId===item.companyId&&i.type===item.type&&i.number.toLowerCase()===item.number.toLowerCase())){if(!confirm('Já existe uma fatura com este número, tipo e empresa. Queres guardar na mesma?'))return}const at=state.invoices.findIndex(x=>x.id===id);if(at>=0)state.invoices[at]=item;else state.invoices.push(item);persist();refresh();closeForm();tab('documents')});
$('invoiceRows').addEventListener('click',e=>{const edit=e.target.closest('[data-edit]'),del=e.target.closest('[data-delete]');if(edit)showForm(edit.dataset.edit);if(del&&confirm('Apagar esta fatura definitivamente?')){state.invoices=state.invoices.filter(x=>x.id!==del.dataset.delete);persist();refresh()}});
$('companyForm').addEventListener('submit',e=>{e.preventDefault();const name=$('companyName').value.trim();if(!name)return;if(state.companies.some(c=>c.name.toLocaleLowerCase()===name.toLocaleLowerCase())){alert('Essa empresa já existe.');return}state.companies.push({id:uid(),name});$('companyName').value='';persist();refresh()});$('companyList').addEventListener('click',e=>{const btn=e.target.closest('[data-delcompany]');if(!btn)return;const id=btn.dataset.delcompany;if(state.companies.length===1){alert('É necessário manter pelo menos uma empresa.');return}if(state.invoices.some(i=>i.companyId===id)){alert('Esta empresa tem faturas. Apaga ou transfere primeiro esses registos.');return}if(confirm('Eliminar a empresa?')){state.companies=state.companies.filter(c=>c.id!==id);persist();refresh()}});
['dashCompany','dashMonth'].forEach(id=>$(id).addEventListener('change',paintDashboard));$('dashAllMonths').addEventListener('click',()=>{$('dashMonth').value='';paintDashboard()});['invoiceCompany','invoiceType','invoiceSearch'].forEach(id=>$(id).addEventListener('input',paintInvoices));
function download(filename,content,mime){const blob=new Blob([content],{type:mime}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function exportJson(){download('lucropilot-copia-'+new Date().toLocaleDateString('sv-SE')+'.json',JSON.stringify(state,null,2),'application/json')}
$('exportTop').addEventListener('click',exportJson);$('exportJson').addEventListener('click',exportJson);
$('exportCsv').addEventListener('click',()=>{const rows=[['Empresa','Tipo','Data','Numero','Entidade','Categoria','Valor_sem_IVA','IVA','Estado'],...state.invoices.map(i=>[companyName(i.companyId),i.type==='sale'?'Venda':'Compra',i.date,i.number,i.partner,i.category,i.amount.toFixed(2),i.vat.toFixed(2),i.status])];const csv='\ufeff'+rows.map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')).join('\r\n');download('lucropilot-faturas.csv',csv,'text/csv;charset=utf-8')});
$('importJson').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;try{if(file.size>15000000)throw Error('Ficheiro demasiado grande.');const x=JSON.parse(await file.text());if(!validData(x))throw Error('Estrutura JSON inválida.');if(!confirm('Substituir TODOS os dados atuais pela cópia importada?'))return;state=x;persist();refresh();alert('Cópia importada com sucesso.')}catch(err){alert('Não foi possível importar: '+err.message)}finally{e.target.value=''}});
$('resetData').addEventListener('click',()=>{if(confirm('ATENÇÃO: apagar todas as empresas e faturas deste navegador? Esta operação não pode ser anulada.')&&confirm('Confirmas a eliminação definitiva?')){state=cleanInitial();persist();refresh();tab('dashboard')}});
refresh();
</script>
</body></html>
